[Unit]
Description=Return votes from completed SPC monthly challenges
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec --user discourse --env RAILS_ENV=production --env SPC_APPLY=1 --workdir /var/www/discourse app bin/rails runner /shared/spc-challenge-vote-reset.rb
TimeoutStartSec=240

[Unit]
Description=Announce crowned SPC monthly challenge rounds
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec --user discourse --env RAILS_ENV=production --env SPC_APPLY=1 --workdir /var/www/discourse app bin/rails runner /shared/spc-challenge-results.rb
TimeoutStartSec=600
